# Copy to config/.env.local and fill in. Never commit a filled-in file.
#
# config/.env.<environment> holds values safe to share (URLs, tenant names).
# config/.env.local holds anything personal or secret, and is gitignored.
# A real environment variable always wins over both, which is how CI injects
# secrets without a file existing at all.

# Which config/.env.<name> file to load. Defaults to "local".
ENVIRONMENT=local

# Root of the application under test in the browser.
UI_BASE_URL=http://localhost:3000

# Root of the HTTP API under test.
API_BASE_URL=http://localhost:3000/api

# Optional. Bearer token for API suites that authenticate with one.
API_TOKEN=

# Sign-in credentials. Set both or neither: half a pair is rejected at startup.
# Leave empty to run only the suites that need no session.
APP_USERNAME=
APP_PASSWORD=
